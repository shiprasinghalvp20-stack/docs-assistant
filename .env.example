# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env - it is listed in .gitignore.

# Which LLM to use for answering: "groq" or "gemini"
LLM_PROVIDER=groq

# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# Get a free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini models (free tier, checked Nov 2026). The fallback is used automatically when
# the main model is overloaded (503) or rate-limited (429). LLM_FALLBACK_MODEL=none disables it.
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# Where uploaded PDFs and the vector database are stored
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma
# Uploads larger than this are rejected with HTTP 413
MAX_UPLOAD_MB=20

# Embedding model (local, free; downloaded once ~90 MB). Changing it requires
# re-indexing: delete data/chroma and ingest your PDFs again.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COLLECTION_NAME=docs

# Chunking (in characters). Overlap must be smaller than size.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval: max chunks per question, and minimum cosine similarity (-1..1).
# MIN_SCORE was calibrated for all-MiniLM-L6-v2 - re-measure if you change the model.
TOP_K=4
MIN_SCORE=0.25
